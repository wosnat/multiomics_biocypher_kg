      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Differential Timing for Glucose Assimilation in Prochlorococcus and Coexistent Microbial Populations in the North Pacific Subtropical Gyre</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:identifier>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">10.1128/spectrum.02466-22</rdf:li>
