# .env.alpha — alpha-stack secrets, gitignored. Real values live in
# .env.alpha (never committed). Copy this file to .env.alpha and fill the
# placeholders before running /release-kg --target local or scripts/alpha_*.sh.

# Lab box bind IP — the campus-routable address testers connect to.
# Pin this via a DHCP reservation / static IP / lab DNS name; otherwise a
# reboot would change the URI and break every tester (plan §6.4 question #1).
ALPHA_BIND_IP=132.75.249.47

# Bootstrap admin password — operator-only, never distributed to testers.
# Used internally by /release-kg --target local to provision the shared
# `explorer` read login via CREATE USER ... after the alpha-deploy starts
# with auth enabled. Replace REPLACE_WITH_... with a real strong password
# (no quotes — compose's --env-file does not strip them).
NEO4J_AUTH=neo4j/REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Shared read login distributed out-of-band to lab testers (e.g. lab Slack
# DM). Provisioned fresh each release because blue/green wipes the prior
# color's volume on the next swap.
ALPHA_EXPLORER_PASSWORD=REPLACE_WITH_STRONG_SHARED_PASSWORD
